# Everything here can also be changed in the settings window (gear icon).

# Free Groq key: https://console.groq.com/keys
LLM_API_KEY=

# Language you speak and Jully answers in: en or pt
LANGUAGE=en

# Wake word: "hey_jarvis" (ready-made) or models/hey_jully.onnx (trained by you)
WAKEWORD=hey_jarvis
WAKEWORD_THRESHOLD=0.35

# Optional
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
# Leave empty to use the default voice of the language
VOICE=
VOICE_RATE=+10%

# Microphone (run diagnose.py to find the index); -1 = Windows default
MIC_INDEX=-1
MIC_GAIN=3
MIN_SPEECH_LEVEL=200

# 0 stops listening for a follow-up right after the reply
FOLLOW_UP=1

# What "look at screen" sends to the AI: screen (all monitors) or window (active window only)
SCREEN_CAPTURE=screen

# City used when you ask about the weather without naming one
CITY=

# Websites Jully may open (comma-separated domains; * allows all)
ALLOWED_SITES=google.com, youtube.com, github.com, wikipedia.org, whatsapp.com, spotify.com, netflix.com, twitch.tv, reddit.com, linkedin.com
