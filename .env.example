# Chave grátis da Groq: https://console.groq.com/keys
LLM_API_KEY=

# Palavra de ativação: "hey_jarvis" (pronta) ou models/hey_jully.onnx (treinada por você)
WAKEWORD=hey_jarvis
WAKEWORD_LIMIAR=0.5

# Opcionais
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
WHISPER_MODEL=base
VOZ=pt-BR-FranciscaNeural
VELOCIDADE_VOZ=+10%

# Microfone (rode diagnostico.py para achar o índice); -1 = padrão do Windows
MIC_INDEX=-1
MIC_GANHO=3
REPLICA=1  # 0 desliga a escuta após a resposta
